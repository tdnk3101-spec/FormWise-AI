# FormWise AI — Backend Environment Configuration
APP_NAME="FormWise AI"
APP_ENV="development"
API_V1_STR="/api/v1"
SECRET_KEY="formwise-ai-super-secret-production-key-2026-secure-jwt"

# Database Configuration (PostgreSQL / Supabase / SQLite)
DATABASE_URL="sqlite:///./formwise.db"
# Example PostgreSQL: postgresql://postgres:password@localhost:5432/formwise

# Supabase Auth & Storage Integration (Optional for local dev, used if configured)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# AI / LLM Configuration (Multi-provider: gemini, openai, heuristic_local)
LLM_PROVIDER="gemini"
LLM_API_KEY=""
LLM_MODEL="gemini-2.5-flash"

# Storage
STORAGE_DIR="./backend_storage"
MAX_UPLOAD_SIZE_MB=25

# CORS & Frontend URL
FRONTEND_URL="http://localhost:5173"

